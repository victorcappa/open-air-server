+#if defined(__APPLE__) && defined(UXPLAY_HAVE_APPLE_P2P)
+struct PcloseDeleter {
+    void operator()(FILE *fp) const {
+        if (fp) pclose(fp);
+    }
+};
+
+static std::string exec_command(const char *command) {
+    std::array<char, 128> buffer;
+    std::string result;
+    std::unique_ptr<FILE, PcloseDeleter> pipe(popen(command, "r"));
+    if (!pipe) return result;
+    while (fgets(buffer.data(), buffer.size(), pipe.get()) != NULL) {
+        result += buffer.data();
+    }
+    return result;
+}
+#endif
